<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/surface"
	android:foreground="@drawable/bg_shadow_edges"
	android:id="@+id/_main">
	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/viewpager1"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />
	<org.aurora.view.MyBaseToolbar
		android:id="@+id/my_toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="6dp"
		android:layout_gravity="top" />
	<org.aurora.view.MyBaseNavigationBar
		android:id="@+id/nav_bar"
		android:layout_width="wrap_content"
		android:layout_height="48dp"
		android:layout_margin="18dp"
		android:background="@color/surfaceContainerHigh"
		android:layout_gravity="center_horizontal|bottom"
		app:ax_menu="@menu/nav_menu_bottom"
		app:ax_elevation="4dp" />
</FrameLayout>
