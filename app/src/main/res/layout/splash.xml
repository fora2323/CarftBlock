<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splash_icon"
        android:layout_width="@dimen/size_width_135dp"
        android:layout_height="@dimen/size_height_135dp"
        app:lottie_fileName="anim/anim.json" 
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="@dimem/size_width_135dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        app:trackCornerRadius="@dimen/radius_4dp"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/secondaryContainer"
        app:layout_constraintBottom_toTopOf="@+id/tv_architecture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_architecture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/onSurface"
        android:textSize="@dimen/size_text_12sp"
        android:textAppearance="@style/TextAppearance.Aurora.Title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>