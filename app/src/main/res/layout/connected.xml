<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">
    
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_toolbar_connected"
        app:titleTextColor="@color/onSurface"
        app:titleMarginStart="@dimen/main_margin_toolbar"
        app:navigationIconTint="@color/onSurface"
        app:contentInsetStartWithNavigation="0dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/pedding_16dp">

            <!-- Card Debugging TCP (Hanya muncul jika sudah pernah pairing) -->
            <LinearLayout
                android:id="@+id/card_tcp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_android"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Aktivasi melalui Debugging TCP"
                        android:textColor="@color/onSurface"
                        android:textSize="@dimen/size_text_18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="Anda dapat melakukan Aktivasi menggunakan debugging TCP, tanpa terhubung ke komputer.\n\nPort TCP: 5555"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="@dimen/size_text_12sp" />

                <!-- TCP Button Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_connect_tcp"
                        style="@style/Base.Theme.AuroraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginBottom="6dp"
                        android:text="Hubungkan ke TCP"
                        app:icon="@drawable/ic_play" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_tcp"
                        style="@style/Base.Theme.AuroraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Hentikan TCP"
                        app:icon="@drawable/ic_stop" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card Wireless Debugging -->
            <LinearLayout
                android:id="@+id/card_wireless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/title_wareless_connected"
                        android:textColor="@color/onSurface"
                        android:textSize="@dimen/size_text_18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/title_dec_wareless_connected"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="@dimen/size_text_12sp" />

                <!-- Button Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step"
                        style="@style/Base.Theme.AuroraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginBottom="2dp"
                        android:text="Step-by-step"
                        app:icon="@drawable/ic_open" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pairing"
                        style="@style/Base.Theme.AuroraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginBottom="2dp"
                        android:text="Pairing"
                        app:icon="@drawable/ic_link" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        style="@style/Base.Theme.AuroraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Start"
                        app:icon="@drawable/ic_play" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
