<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">
    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/title_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:text="@string/title_toolbar_name_main_game"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/title_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:text="@string/title_toolbar_name_main_dec_game"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linear2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/linear3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/titile_credits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:padding="6dp"
                android:text="@string/title_developer"
                android:textColor="@color/color_gray_white"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/id_user_token"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_radius_50"
                android:focusable="false"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="000001"
                android:textColor="@color/onSurface"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</merge>